rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════
    // YARDIMCI FONKSİYONLAR
    // ═══════════════════════════════════════

    // Giriş yapmış mı?
    function isSignedIn() {
      return request.auth != null;
    }

    // Kendi belgesi mi?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════
    // USERS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /users/{userId} {
      // Giriş yapmış her kullanıcı profilleri okuyabilir (oyuncu, işveren, yönetmen, admin vb.)
      allow read: if isSignedIn();

      // Kayıt sırasında kendi profillerini oluşturabilirler
      allow create: if isOwner(userId) || isSignedIn();

      // Kendi profilini veya yetkili işlemleri güncelleyebilir
      allow update, delete: if isOwner(userId) || isSignedIn();
    }

    // ═══════════════════════════════════════
    // PROJECTS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /projects/{projectId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ═══════════════════════════════════════
    // AUDITIONS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /auditions/{auditionId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ═══════════════════════════════════════
    // NOTIFICATIONS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // ═══════════════════════════════════════
    // SKILLS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /skills/{skillId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════
    // MODERATOR APPROVALS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /moderator_approvals/{approvalId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════
    // CHATS KOLEKSİYONU & MESSAGES SUBCOLLECTION
    // ═══════════════════════════════════════
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ═══════════════════════════════════════
    // CALENDAR EVENTS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /calendar_events/{eventId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════
    // SETTINGS KOLEKSİYONU
    // ═══════════════════════════════════════
    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }
  }
}
