{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "castelle-ce64b",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "site": "castelle-web",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/@(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json|main.dart.js)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "castelle-ce64b",
          "appId": "1:977939722051:android:26e1b5da9273acfc8a49f6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "castelle-ce64b",
          "configurations": {
            "android": "1:977939722051:android:26e1b5da9273acfc8a49f6",
            "ios": "1:977939722051:ios:04a606d3853a563c8a49f6"
          }
        }
      }
    }
  }
}
